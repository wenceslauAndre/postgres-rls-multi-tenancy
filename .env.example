# Two connection strings, and the difference between them is the whole point.

# Owns the tables and applies sql/. Bypasses RLS. Never used to serve a request.
OWNER_DATABASE_URL=postgres://postgres:postgres@localhost:5433/rls_demo

# What "the application" connects as: created by sql/02-app-role.sql,
# NOBYPASSRLS, owns nothing.
APP_DATABASE_URL=postgres://app_user:app_password@localhost:5433/rls_demo
